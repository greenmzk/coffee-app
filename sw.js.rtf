\f0\fs24 \cf0 const CACHE_NAME = "brew-day-v1";\
\
const APP_SHELL = [\
  "./",\
  "./index.html",\
  "./manifest.json",\
\
  "./icons/favicon.svg",\
  "./icons/favicon-32x32.png",\
  "./icons/apple-touch-icon.png",\
